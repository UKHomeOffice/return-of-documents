{
  "name": "rod",
  "version": "1.0.0",
  "main": "index.js",
  "description": "Return Of Documents (ROD)",
  "engines": {
    "node": ">=24.19.0 <25.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:dev": "hof-build watch --env",
    "test": "NODE_ENV=test yarn run test:lint && yarn run test:unit",
    "test:lint": "eslint . --config ./node_modules/eslint-config-hof/default.js",
    "build": "hof-build",
    "postinstall": "hof-build",
    "test:unit": "nyc _mocha \"test/_unit/**/*.spec.js\""
  },
  "dependencies": {
    "accessible-autocomplete": "^3.0.1",
    "axios": "^1.19.0",
    "bl": "^6.1.6",
    "busboy": "^1.6.0",
    "crypto-random-string": "^6.0.0",
    "hof": "^24.5.0",
    "notifications-node-client": "^8.4.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^8.57.1",
    "eslint-config-hof": "^1.3.4",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "proxyquire": "^2.1.3",
    "reqres": "^3.0.1",
    "sinon": "^22.1.0",
    "sinon-chai": "^3.7.0"
  },
  "resolutions": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UKHomeOffice/return-of-documents.git"
  },
  "author": "Temitope Ayoku, Mike Maratheftis & SAS HOF Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UKHomeOffice/return-of-documents/issues"
  },
  "homepage": "https://github.com/UKHomeOffice/return-of-documents#readme",
  "mocha": {
    "reporter": "spec",
    "require": "test/common.js",
    "recursive": "true",
    "timeout": "9000",
    "exit": "true"
  }
}
